# =============================================================================
# LMS Backend — environment variables
# Copy this file to .env and fill in real values before running the server:
#   cp .env.example .env
# .env is gitignored — never commit real secrets.
# =============================================================================

# PostgreSQL connection string.
DATABASE_URL=postgresql://lms_user:lms_password@localhost:5433/lms_db

# Secret used to sign JWT access/refresh tokens. REQUIRED.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string-before-any-real-use

PORT=4000
CORS_ORIGIN=http://localhost:5173

# =============================================================================
# Email (transactional emails — registration, verification, loan status,
# payment reminders, password reset, etc. — see src/services/emailService.js)
# =============================================================================

# Base URL of the FRONTEND app (not the backend) — used to build links
# inside emails, e.g. https://yourapp.com/verify-email?token=...
APP_BASE_URL=http://localhost:5173

# Display name and address emails are sent from.
SMTP_FROM_NAME=LMS
SMTP_FROM_EMAIL=no-reply@yourcompany.com

# SMTP server credentials. If SMTP_HOST is left unset, the app runs in a
# DEV-SAFE MODE: no real emails are sent (nodemailer's JSON transport is
# used instead), but every send still writes correctly to the email_log
# table — this lets you develop and test the full email flow locally
# without real credentials. Set these before deploying anywhere real.
#
# Common options:
#   - A real transactional provider (recommended for production):
#     SendGrid, Mailgun, Amazon SES, Postmark — each gives you an SMTP
#     host/port/user/password to fill in below.
#   - Gmail (fine for early testing, NOT recommended for production
#     volume — Gmail will rate-limit/block bulk sending):
#     SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
#     SMTP_USER=<your address>, SMTP_PASSWORD=<an App Password, not your
#     real Gmail password — see Google Account > Security > App Passwords>
#   - Mailtrap (recommended for local/staging testing — captures emails
#     in a web inbox instead of sending them anywhere real):
#     SMTP_HOST=sandbox.smtp.mailtrap.io, SMTP_PORT=2525
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
